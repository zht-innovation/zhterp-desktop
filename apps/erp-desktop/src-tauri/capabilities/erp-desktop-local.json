{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "erp-desktop-local",
    "description": "Access to ERP requests, the desktop session and user-selected files from the bundled ERP window.",
    "windows": ["erp"],
    "local": true,
    "platforms": ["windows", "macOS"],
    "permissions": [
        "allow-desktop-info",
        "allow-desktop-about-ready",
        "allow-desktop-quick-launch-ready",
        "allow-desktop-panel-ready",
        "allow-desktop-open-panel",
        "allow-desktop-autostart-state",
        "allow-set-desktop-autostart",
        "allow-reset-desktop-window-layout",
        "allow-desktop-business-context",
        "allow-sync-desktop-business-session",
        "allow-open-desktop-business-window",
        "allow-list-desktop-business-windows",
        "allow-update-desktop-business-window",
        "allow-sync-download-account",
        "allow-prepare-local-download",
        "allow-fail-local-download",
        "allow-download-remote-file",
        "allow-save-download-file",
        "allow-retry-download-task",
        "allow-cancel-download-task",
        "allow-open-download-task",
        "allow-clear-download-history",
        "allow-set-download-directory",
        "allow-desktop-print-bind-session",
        "allow-desktop-print-printers",
        "allow-desktop-print-list",
        "allow-desktop-print-prepare",
        "allow-desktop-print-preview",
        "allow-desktop-print-submit",
        "allow-desktop-print-cancel",
        "allow-desktop-print-reprint",
        "allow-desktop-print-registration",
        "allow-desktop-print-settings",
        "allow-desktop-print-image",
        "allow-check-desktop-update",
        "allow-install-desktop-update",
        "allow-erp-request",
        "allow-upload-product-image",
        "allow-restore-desktop-session",
        "allow-save-desktop-session",
        "allow-clear-desktop-session",
        "allow-sync-desktop-notifications",
        "allow-refresh-desktop-notifications",
        "core:event:allow-listen",
        "core:event:allow-unlisten",
        "allow-open-local-files",
        "allow-save-local-file"
    ]
}
